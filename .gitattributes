# Git LFS tracking for compiled native static and shared libraries
libs/**/*.a filter=lfs diff=lfs merge=lfs -text
libs/**/*.so filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for large testing media/archives (safety net)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.fluxx filter=lfs diff=lfs merge=lfs -text
