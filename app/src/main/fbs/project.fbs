namespace fluxx.schema;

// v13 (GRAPH G1): explicit wire values, independent of the Kotlin enum order.
enum EasingType : byte {
  LINEAR = 0,
  EASY_EASE = 1,
  HOLD = 2,
  CUSTOM = 3,
  BOUNCE = 4,
  ELASTIC = 5
}

// v13: generic curve parameters of the departing key's segment. CUSTOM: cubic-bezier (x1, y1, x2, y2);
// BOUNCE: (count, restitution, -, -); ELASTIC: (oscillations, damping, -, -). Defaults are the Easy Ease bezier.
table Keyframe1D {
  time_us: long;
  value: float;
  easing: EasingType = EASY_EASE;
  curve_a: float = 0.33;
  curve_b: float = 0;
  curve_c: float = 0.67;
  curve_d: float = 1;
}

table Keyframe2D {
  time_us: long;
  x: float;
  y: float;
  easing: EasingType = EASY_EASE;
  // v13: one curve shared by the X and Y channels.
  curve_a: float = 0.33;
  curve_b: float = 0;
  curve_c: float = 0.67;
  curve_d: float = 1;
}

table AnimatableProperty1D {
  is_animated: bool;
  static_value: float;
  keyframes: [Keyframe1D];
}

table AnimatableProperty2D {
  is_animated: bool;
  static_x: float;
  static_y: float;
  keyframes: [Keyframe2D];
}

table Marker {
  id: ulong;
  time_us: long;
  color_argb: int = -26624;
  description: string;
}

table ColourKeyframe { time_us: long; argb: int = -1; easing: EasingType = EASY_EASE; curve_a: float = 0.33; curve_b: float = 0; curve_c: float = 0.67; curve_d: float = 1; }
table FontAxisValue { tag: string; value: AnimatableProperty1D; }
table TextFontReference { family: string; style: int; sha256: string; face_index: int; named_instance: int = -1; axes: [FontAxisValue]; post_script_name: string; style_name: string; }
table TextManualKerning { character: int; amount: float; }
table TextStyleRun {
  start: int; end: int; font: TextFontReference; size_factor: float = 1;
  has_fill: bool; fill: int = -1; has_stroke: bool; stroke: int = -16777216;
  stroke_delta: float; tracking_delta: float; baseline_delta: float;
  faux_bold: bool; faux_italic: bool; caps: int; script_position: int;
  // caps: 0 Normal, 1 ALL CAPS, 2 Small Caps, 3 lowercase (additive v12).
  horizontal_scale: float = 100; vertical_scale: float = 100; kerning: int;
  manual_kerning: [TextManualKerning];
}
table TextParagraphStyle { alignment: int = -1; indent_left: float; indent_right: float; indent_first: float; space_before: float; space_after: float; direction: int; }
table TextSourceDocument { version: uint = 1; text: string; runs: [TextStyleRun]; paragraphs: [TextParagraphStyle]; box_width: float; }
table StringKeyframe { time_us: long; value: string; document: TextSourceDocument; }
table AnimatableColour { is_animated: bool; static_value: int = -1; keyframes: [ColourKeyframe]; }
table AnimatableString { is_animated: bool; static_value: string; keyframes: [StringKeyframe]; document: TextSourceDocument; }
table TextSeedKeyframe { time_us:long; seed:ulong; }
table TextRangeSelector {
  version: uint = 1;
  id: ulong;
  enabled: AnimatableProperty1D;
  start: AnimatableProperty1D;
  end: AnimatableProperty1D;
  offset: AnimatableProperty1D;
  units: AnimatableProperty1D;
  based_on: AnimatableProperty1D;
  shape: AnimatableProperty1D;
  smoothness: AnimatableProperty1D;
  ease_high: AnimatableProperty1D;
  ease_low: AnimatableProperty1D;
  mode: AnimatableProperty1D;
  amount: AnimatableProperty1D;
  min_amount: AnimatableProperty1D;
  max_amount: AnimatableProperty1D;
  randomize_order: AnimatableProperty1D;
  seed: ulong;
  // v12/T4: range and deterministic wiggly selectors share universal tracks.
  kind: AnimatableProperty1D;
  wiggles_per_second: AnimatableProperty1D;
  correlation: AnimatableProperty1D;
  temporal_phase: AnimatableProperty1D;
  spatial_phase: AnimatableProperty1D;
  lock_dimensions: AnimatableProperty1D;
  seed_keyframes: [TextSeedKeyframe];
}
table TextPropertyOverride {
  version: uint = 1;
  property_id: uint;
  scalar: AnimatableProperty1D;
  vector: AnimatableProperty2D;
  colour: AnimatableColour;
}
table TextAnimator {
  version: uint = 1;
  range_selector: TextRangeSelector;
  property_overrides: [TextPropertyOverride];
  id: ulong;
  name: string;
  enabled: AnimatableProperty1D;
  selectors: [TextRangeSelector];
  anchor_grouping: AnimatableProperty1D;
}
table TextPayload {
  source: AnimatableString;
  size: AnimatableProperty1D;
  fill: AnimatableColour;
  font_id: string;
  alignment: int = 1;
  text_animators: [TextAnimator];
  // v10: additive F1 tracks. Paint order is a validated 0/1 scalar with hold evaluation.
  tracking: AnimatableProperty1D;
  leading: AnimatableProperty1D;
  baseline_shift: AnimatableProperty1D;
  stroke_colour: AnimatableColour;
  stroke_width: AnimatableProperty1D;
  stroke_over_fill: AnimatableProperty1D;
  // v11: default-on hold boolean. Effective only when evaluated layer tracking is zero.
  ligatures: AnimatableProperty1D;
}

table Layer {
  // Unique identifier for the layer
  id: ulong;

  // Transform parameters
  position_x: float;
  position_y: float;
  scale_x: float = 1.0;
  scale_y: float = 1.0;
  rotation: float;
  opacity: float = 1.0;

  // Content reference (content:// URI string)
  asset_uri: string;
  // Additive v2 fields. Type: 0 video, 1 image, 2 solid, 3 text.
  type: int;
  z_order: int;
  start_us: long;
  source_in_us: long;
  duration_us: long = -1; // -1 means unresolved, not an empty clip
  visible: bool = true;
  asset_id: string;
  source_duration_us: long = -1;
  muted: bool;
  audio_gain: float = 1.0;
  name: string;
  solid_color_argb: int = -12290100;
  // v4: stable layer fit/position space; zero pairs use the pre-resize canvas for legacy layers.
  reference_width: int;
  reference_height: int;
  // v4 additive animation fields
  anim_position: AnimatableProperty2D;
  anim_scale: AnimatableProperty2D;
  anim_rotation: AnimatableProperty1D;
  anim_opacity: AnimatableProperty1D;
  // v5: signed composition-time origin. Presence distinguishes a real -1 origin from legacy unset.
  keyframe_anchor_us: long = -1;
  has_keyframe_anchor: bool = false;
  // v6: spatial pivot in source-local bounds, independent of temporal keyframe origin.
  // v12 additive validation: finite normalized anchors within +/-1,000,000; Group text pivots may lie outside the piece.
  anchor_x: float = 0.5;
  anchor_y: float = 0.5;
  markers: [Marker];
  text_payload: TextPayload;
}

table Composition {
  layers: [Layer];
  width: int = 1080;
  height: int = 1920;
  duration_us: long = -1;
  fps_numerator: int = 30;
  fps_denominator: int = 1;
  markers: [Marker];
  start_timecode_us: long;
}

table Project {
  // Schema version for future backward compatibility checks
  version: int;
  main_comp: Composition;
}

root_type Project;
